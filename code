        if (excusesData && excusesData.length > 0) {
            html += `<div class="stats-section"><div class="stats-title">Attaisnojumi</div>
                ${[...excusesData].sort((a, b) => new Date(b.period.from) - new Date(a.period.from)).map(e => {
